---
import Icon from './Icon.astro';
import Tunduk from './Tunduk.astro';
import { PHONE_DISPLAY, SOCIAL, TEL, WA_HELLO } from '../data/site';

// 40 rays, like the sun on the flag: one for each of the Kyrgyz tribes
const rays = Array.from({ length: 40 }, (_, i) => i * 9);
const year = new Date().getFullYear();
---

<footer class="foot" id="contacts">
  <div class="sun" aria-hidden="true">
    <svg viewBox="-100 -100 200 200">
      {rays.map((a) => <path d="M-2.2 -34 L0 -98 L2.2 -34Z" transform={`rotate(${a})`} />)}
      <circle r="30" />
    </svg>
  </div>

  <div class="wrap foot__in">
    <p class="ak" data-reveal>Ак жол!</p>
    <p class="ak__sub" data-reveal style="--d:1">«Ак жол» — так в Кыргызстане желают светлой, доброй дороги. Пусть ваша будет именно такой.</p>
    <div class="foot__cta" data-reveal style="--d:2">
      <a class="btn btn-gold" href={WA_HELLO} target="_blank" rel="noopener" data-cta="footer-wa">
        <span class="btn__icon btn__icon--wa"><Icon name="whatsapp" size={22} /></span>
        <span>Написать в WhatsApp</span>
      </a>
      <a class="btn btn-glass" href={TEL} data-cta="footer-call">
        <span class="btn__icon btn__icon--ghost"><Icon name="phone" size={20} /></span>
        <span>{PHONE_DISPLAY}</span>
      </a>
      <button class="btn btn-glass btn-square" type="button" data-copy={PHONE_DISPLAY} data-copied="Номер скопирован" aria-label="Скопировать номер">
        <Icon name="copy" size={20} />
      </button>
    </div>

    <ul class="social" role="list" aria-label="Нурбек в соцсетях" data-reveal style="--d:3">
      {SOCIAL.map((s) => (
        <li>
          <a class={`soc soc--${s.id}`} href={s.url} target="_blank" rel="noopener me" data-cta={`footer-${s.id}`}>
            <span class="soc__icon"><Icon name={s.id === 'lalafo' ? 'tag' : s.id} size={20} /></span>
            <span class="soc__text"><b>{s.name}</b><span>{s.handle}</span></span>
          </a>
        </li>
      ))}
      <li>
        <button class="soc soc--share" type="button" data-share data-cta="footer-share">
          <span class="soc__icon"><Icon name="share" size={20} /></span>
          <span class="soc__text"><b>Поделиться</b><span>отправить другу</span></span>
        </button>
      </li>
      <li>
        <a class="soc soc--contact" href="/nurbek.vcf" type="text/vcard" data-cta="footer-vcf">
          <span class="soc__icon"><Icon name="contact" size={20} /></span>
          <span class="soc__text"><b>Контакт</b><span>сохранить в телефон</span></span>
        </a>
      </li>
    </ul>

    <div class="foot__grid">
      <div class="foot__brand">
        <Tunduk size={40} stroke={3.2} class="foot__mark" />
        <p><b>Трансфер по Кыргызстану</b><br />Водитель Нурбек · Toyota Sienna, 7 мест</p>
      </div>
      <ul class="foot__facts" role="list">
        <li><Icon name="pin" size={18} />Бишкек → весь Кыргызстан</li>
        <li><Icon name="clock" size={18} />На связи 24/7</li>
        <li><Icon name="whatsapp" size={18} /><a href={WA_HELLO} target="_blank" rel="noopener">WhatsApp {PHONE_DISPLAY}</a></li>
      </ul>
    </div>
    <span class="band foot__band" aria-hidden="true"></span>
    <p class="copy">© {year} Нурбек · Трансфер по Кыргызстану</p>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    overflow: hidden;
    padding: clamp(90px, 12vw, 170px) 0 calc(28px + env(safe-area-inset-bottom));
    background:
      radial-gradient(60% 50% at 50% 100%, rgb(246 196 67 / 0.16), transparent 70%),
      linear-gradient(to bottom, var(--color-night), #0c1430 60%, #10183a);
    isolation: isolate;
  }
  .sun {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: clamp(40px, 6vw, 80px);
    width: min(980px, 150vw);
    aspect-ratio: 1;
    translate: -50% 0;
    color: var(--color-gold);
    opacity: 0.13;
    mask: linear-gradient(to bottom, #000 30%, transparent 62%);
  }
  .sun svg { width: 100%; height: 100%; fill: currentColor; animation: turn 120s linear infinite; }
  @keyframes turn { to { rotate: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .sun svg { animation: none; } }

  .foot__in { text-align: center; }
  .ak {
    margin: 0;
    font: 900 clamp(4.2rem, 1.5rem + 13vw, 13rem)/0.85 var(--font-display);
    letter-spacing: -0.045em;
    text-transform: uppercase;
    background: linear-gradient(180deg, #fff6d8 0%, var(--color-gold) 55%, var(--color-gold-deep) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 18px 40px rgb(246 196 67 / 0.18));
  }
  .ak__sub { max-width: 560px; margin: 26px auto 34px; color: var(--color-mute); font-size: 1.06rem; }
  .foot__cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }

  .social { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; max-width: 340px; margin: 30px auto 0; padding: 0; list-style: none; }
  @media (min-width: 560px) { .social { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 560px; } }
  @media (min-width: 1100px) { .social { display: flex; flex-wrap: wrap; justify-content: center; max-width: none; } }
  .soc {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 18px 8px 8px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.1);
    color: var(--color-ink);
    text-decoration: none;
    text-align: left;
    transition: background-color 0.3s, transform 0.35s var(--ease-out-expo), border-color 0.3s;
  }
  .soc:hover { background: rgb(255 255 255 / 0.1); border-color: rgb(246 196 67 / 0.4); transform: translateY(-2px); }
  .soc__icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; flex: none; color: #fff; background: rgb(255 255 255 / 0.1); }
  .soc--instagram .soc__icon { background: linear-gradient(45deg, #f9ce34, #ee2a7b 55%, #6228d7); }
  .soc--facebook .soc__icon { background: #1877f2; }
  .soc--lalafo .soc__icon, .soc--contact .soc__icon, .soc--share .soc__icon { background: var(--color-gold); color: var(--color-night); }
  button.soc { width: 100%; font: inherit; cursor: pointer; }
  .btn-square { width: 56px; padding: 0; }
  .soc__text { display: grid; line-height: 1.15; min-width: 0; }
  .soc__text span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .soc__text b { font: 700 0.92rem/1.2 var(--font-display); }
  .soc__text span { font-size: 0.84rem; color: var(--color-mute); }

  .foot__grid {
    display: grid;
    gap: 22px;
    margin-top: clamp(60px, 8vw, 100px);
    padding-top: 30px;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    text-align: left;
  }
  @media (min-width: 768px) {
    .foot__grid { grid-template-columns: 1fr auto; align-items: center; }
  }
  .foot__brand { display: flex; align-items: center; gap: 14px; }
  .foot__brand p { margin: 0; color: var(--color-mute); line-height: 1.45; }
  .foot__brand b { color: var(--color-ink); }
  .foot__mark { color: var(--color-gold); flex: none; }
  .foot__facts { display: flex; flex-wrap: wrap; gap: 10px 22px; margin: 0; padding: 0; list-style: none; color: var(--color-mute); }
  .foot__facts li { display: inline-flex; align-items: center; gap: 8px; }
  .foot__facts :global(svg) { color: var(--color-gold); }
  .foot__facts a { color: var(--color-ink); text-decoration: none; }
  .foot__facts a:hover { color: var(--color-gold); }
  .foot__band { display: block; margin: 30px 0 16px; color: rgb(246 196 67 / 0.35); height: 16px; }
  .copy { margin: 0; font-size: 0.85rem; color: rgb(158 169 197 / 0.7); text-align: left; }
</style>
