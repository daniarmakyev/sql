---
import Icon from './Icon.astro';
import { TEL, WA_HELLO } from '../data/site';
---

<div class="mbar" data-mbar aria-label="Быстрая связь">
  <a class="mbar__wa" href={WA_HELLO} target="_blank" rel="noopener" data-cta="bar-wa">
    <Icon name="whatsapp" size={22} />
    <span>Написать в WhatsApp</span>
  </a>
  <a class="mbar__call" href={TEL} aria-label="Позвонить Нурбеку" data-cta="bar-call"><Icon name="phone" size={22} /></a>
</div>

<style>
  .mbar {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 55;
    display: flex;
    gap: 10px;
    padding: 8px;
    border-radius: 999px;
    background: rgb(9 15 34 / 0.72);
    border: 1px solid rgb(255 255 255 / 0.12);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.75);
    translate: 0 140%;
    transition: translate 0.6s var(--ease-out-expo);
  }
  .mbar.is-on { translate: 0 0; }
  .mbar__wa {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    border-radius: 999px;
    background: var(--color-gold);
    color: var(--color-night);
    font: 700 1rem/1 var(--font-sans);
    text-decoration: none;
  }
  .mbar__call {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: var(--color-ink);
  }
  @media (min-width: 768px) {
    .mbar { display: none; }
  }
</style>

<script>
  // show once the hero's own buttons are out of sight, hide again over the footer's buttons
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const hero = document.querySelector('.hero .bar');
  const foot = document.querySelector('.foot__cta');
  if (bar && hero) {
    const seen = new Map<Element, boolean>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => seen.set(e.target, e.isIntersecting));
      bar.classList.toggle('is-on', !seen.get(hero) && !(foot && seen.get(foot)));
    });
    io.observe(hero);
    if (foot) io.observe(foot);
  }
</script>
